<?xml version="1.0" encoding="utf-8"?>
<Defs>
  <ThingDef>
    <defName>NestedGun</defName>
    <label>Nested Gun</label>
    <description>A gun with tools and verbs.</description>
    <verbs>
      <li>
        <verbClass>Verb_Shoot</verbClass>
        <hasStandardCommand>true</hasStandardCommand>
      </li>
    </verbs>
    <tools>
      <li>
        <label>stock</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
      </li>
      <li>
        <label>barrel</label>
        <capacities>
          <li>Blunt</li>
        </capacities>
      </li>
    </tools>
  </ThingDef>
</Defs>
